@* Họ và tên: [Cả nhóm - điền họ tên các thành viên]
   Mã sinh viên: [MSSV các thành viên]
   Nội dung thực hiện: Thiết kế CSDL, Entity, DbContext, Migration, cấu hình chung *@
@{
    var vaiTro = Context.Session.LayVaiTro();
    var hoTen = Context.Session.LayHoTen();
    var daDangNhap = Context.Session.LayMaTaiKhoan() != null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý Ký túc xá</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏠 KTX UNETI</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav me-auto">
                    @if (daDangNhap && vaiTro == VaiTro.Admin)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="ThongKe" asp-action="Dashboard">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="LoaiPhong" asp-action="Index">Loại phòng</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="PhongKTX" asp-action="Index">Phòng</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="SinhVien" asp-action="Index">Sinh viên</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="DangKyKTX" asp-action="Index">Đăng ký</a></li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Phân phòng</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="PhanPhong" asp-action="ChoDuyet">Duyệt đăng ký</a></li>
                                <li><a class="dropdown-item" asp-controller="PhanPhong" asp-action="Index">Đang ở (chuyển/trả phòng)</a></li>
                                <li><a class="dropdown-item" asp-controller="PhanPhong" asp-action="LichSu">Lịch sử phân phòng</a></li>
                            </ul>
                        </li>
                        <li class="nav-item"><a class="nav-link" asp-controller="ThongKe" asp-action="Index">Thống kê</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="TaiKhoan" asp-action="Index">Tài khoản</a></li>
                    }
                    else if (daDangNhap && vaiTro == VaiTro.SinhVien)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="PhongKTX" asp-action="Index">Danh sách phòng</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="DangKyKTX" asp-action="Create">Đăng ký KTX</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="DangKyKTX" asp-action="CuaToi">Đăng ký của tôi</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="SinhVien" asp-action="CaNhan">Thông tin cá nhân</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="SinhVien" asp-action="LichSu">Lịch sử ở</a></li>
                    }
                </ul>
                <ul class="navbar-nav align-items-center">
                    @if (daDangNhap)
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="TaiKhoan" asp-action="DoiMatKhau">👤 @hoTen <span class="badge bg-light text-primary">@vaiTro</span></a></li>
                        <li class="nav-item">
                            <form asp-controller="TaiKhoan" asp-action="DangXuat" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm ms-2">Đăng xuất</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="btn btn-light btn-sm" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<main class="container-fluid px-4 py-4">
    @if (TempData["ThanhCong"] is string tc)
    {
        <div class="alert alert-success alert-dismissible fade show">@tc<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Loi"] is string loi)
    {
        <div class="alert alert-danger alert-dismissible fade show">@loi<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @RenderBody()
</main>

<footer class="text-center text-muted small py-3 border-top">
    Hệ thống quản lý ký túc xá và phân phòng sinh viên - ASP.NET Core 10 MVC &amp; EF Core 10
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
