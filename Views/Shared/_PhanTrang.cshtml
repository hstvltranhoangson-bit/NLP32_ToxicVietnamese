@* Họ và tên: [Họ tên Sinh viên 2]
   Mã sinh viên: [MSSV 2]
   Nội dung thực hiện: Module 2 - Quản lý phòng KTX, tìm kiếm, lọc, sắp xếp, phân trang *@
@model PhanTrangViewModel
@{
    var action = (string)ViewContext.RouteData.Values["action"]!;
    // Giữ nguyên TOÀN BỘ điều kiện tìm kiếm/lọc/sắp xếp, chỉ thay số trang
    Dictionary<string, string> Lien(int trang)
    {
        var d = new Dictionary<string, string>(Model.RouteValues);
        d["Trang"] = trang.ToString();
        return d;
    }
    int tu = Math.Max(1, Model.Trang - 2), den = Math.Min(Model.TongTrang, Model.Trang + 2);
}
@if (Model.TongTrang > 1)
{
    <nav aria-label="Phân trang">
        <ul class="pagination justify-content-center mb-1">
            <li class="page-item @(Model.Trang == 1 ? "disabled" : "")"><a class="page-link" asp-action="@action" asp-all-route-data="Lien(1)">«</a></li>
            <li class="page-item @(Model.Trang == 1 ? "disabled" : "")"><a class="page-link" asp-action="@action" asp-all-route-data="Lien(Model.Trang - 1)">‹</a></li>
            @for (var i = tu; i <= den; i++)
            {
                <li class="page-item @(i == Model.Trang ? "active" : "")"><a class="page-link" asp-action="@action" asp-all-route-data="Lien(i)">@i</a></li>
            }
            <li class="page-item @(Model.Trang == Model.TongTrang ? "disabled" : "")"><a class="page-link" asp-action="@action" asp-all-route-data="Lien(Model.Trang + 1)">›</a></li>
            <li class="page-item @(Model.Trang == Model.TongTrang ? "disabled" : "")"><a class="page-link" asp-action="@action" asp-all-route-data="Lien(Model.TongTrang)">»</a></li>
        </ul>
    </nav>
}
<p class="text-center text-muted small">Trang @Model.Trang / @Math.Max(1, Model.TongTrang) - Tổng @Model.TongSo bản ghi</p>
