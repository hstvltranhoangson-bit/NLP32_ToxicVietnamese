@* Họ và tên: [Họ tên Sinh viên 3]
   Mã sinh viên: [MSSV 3]
   Nội dung thực hiện: Module 3 - Quản lý sinh viên, đăng ký ở KTX, xem thông tin/lịch sử ở *@
@model QuanLyKyTucXa_UNETI_DHTI17A2ND.Helpers.PagedList<SinhVienDongViewModel>
@{ ViewData["Title"] = "Quản lý sinh viên"; var loc = (LocDanhSachViewModel)ViewBag.Loc; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Quản lý sinh viên</h3>
    <a class="btn btn-primary" asp-action="Create">+ Thêm sinh viên</a>
</div>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="TuKhoa" value="@loc.TuKhoa" class="form-control" placeholder="Mã SV, họ tên, lớp..." /></div>
    <div class="col-md-3">
        <select name="TrangThai" class="form-select">
            <option value="">-- Mọi trạng thái --</option>
            @foreach (var t in TrangThaiChung.TatCa) { <option value="@t" selected="@(loc.TrangThai == t)">@t</option> }
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-primary">Tìm</button> <a class="btn btn-outline-secondary" asp-action="Index">Xóa lọc</a></div>
</form>
@if (!Model.Items.Any()) { <div class="alert alert-info">Không có sinh viên phù hợp.</div> }
else
{
<div class="card"><div class="table-responsive">
<table class="table table-hover align-middle mb-0">
    <thead><tr><th>Mã SV</th><th>Họ tên</th><th>Giới tính</th><th>Lớp</th><th>Khoa</th><th>SĐT</th><th>Trạng thái</th><th>Đang ở KTX</th><th></th></tr></thead>
    <tbody>
    @foreach (var x in Model.Items)
    {
        <tr>
            <td>@x.SinhVien.MaSinhVien</td><td>@x.SinhVien.HoTen</td><td>@x.SinhVien.GioiTinh</td><td>@x.SinhVien.Lop</td><td>@x.SinhVien.Khoa</td><td>@x.SinhVien.SoDienThoai</td>
            <td><span class="badge @HienThiHelper.LopBadge(x.SinhVien.TrangThai)">@x.SinhVien.TrangThai</span></td>
            <td>@(x.DangO ? "Có" : "Không")</td>
            <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@x.SinhVien.MaSinhVien">Chi tiết</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.SinhVien.MaSinhVien">Sửa</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@x.SinhVien.MaSinhVien">Xóa</a>
            </td>
        </tr>
    }
    </tbody>
</table></div></div>
}
<div class="mt-3"><partial name="_PhanTrang" model="(PhanTrangViewModel)ViewBag.PhanTrang" /></div>
