@* Họ và tên: [Họ tên Sinh viên 3]
   Mã sinh viên: [MSSV 3]
   Nội dung thực hiện: Module 3 - Quản lý sinh viên, đăng ký ở KTX, xem thông tin/lịch sử ở *@
@model SinhVien
@{ ViewData["Title"] = "Xóa sinh viên"; }
<h3 class="mb-3 text-danger">Xóa sinh viên</h3>
<div class="alert alert-warning">Bạn có chắc muốn xóa sinh viên <strong>@Model.HoTen</strong> (@Model.MaSinhVien)?
    @if (Model.DangKyKTXs.Count > 0) { <div class="mt-2 fw-bold">Sinh viên đã có @Model.DangKyKTXs.Count đăng ký KTX nên hệ thống sẽ từ chối xóa để giữ lịch sử. Hãy khóa hồ sơ thay vì xóa.</div> }
</div>
<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.MaSinhVien" />
    <button class="btn btn-danger" type="submit">Xác nhận xóa</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
</form>
