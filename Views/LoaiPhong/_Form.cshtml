@* Họ và tên: [Họ tên Sinh viên 1]
   Mã sinh viên: [MSSV 1]
   Nội dung thực hiện: Module 1 - Tài khoản, đăng nhập, phân quyền, quản lý loại phòng *@
@model LoaiPhong
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3">
    <div class="col-md-6"><label asp-for="TenLoaiPhong" class="form-label"></label><input asp-for="TenLoaiPhong" class="form-control" /><span asp-validation-for="TenLoaiPhong" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="SoNguoiToiDa" class="form-label"></label><input asp-for="SoNguoiToiDa" type="number" min="1" class="form-control" /><span asp-validation-for="SoNguoiToiDa" class="text-danger"></span></div>
    <div class="col-md-3"><label asp-for="DonGiaThang" class="form-label"></label><input asp-for="DonGiaThang" type="number" step="1000" min="1" class="form-control" /><span asp-validation-for="DonGiaThang" class="text-danger"></span></div>
    <div class="col-md-12"><label asp-for="MoTa" class="form-label"></label><textarea asp-for="MoTa" rows="3" class="form-control"></textarea><span asp-validation-for="MoTa" class="text-danger"></span></div>
    <div class="col-md-4">
        <label asp-for="TrangThai" class="form-label"></label>
        <select asp-for="TrangThai" class="form-select">
            @foreach (var t in TrangThaiChung.TatCa) { <option value="@t">@t</option> }
        </select>
        <span asp-validation-for="TrangThai" class="text-danger"></span>
    </div>
</div>
