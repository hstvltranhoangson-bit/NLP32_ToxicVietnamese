@* Họ và tên: [Họ tên Sinh viên 1]
   Mã sinh viên: [MSSV 1]
   Nội dung thực hiện: Module 1 - Tài khoản, đăng nhập, phân quyền, quản lý loại phòng *@
@model List<LoaiPhongDongViewModel>
@{ ViewData["Title"] = "Loại phòng"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Quản lý loại phòng</h3>
    <a class="btn btn-primary" asp-action="Create">+ Thêm loại phòng</a>
</div>
<div class="card"><div class="table-responsive">
<table class="table table-hover align-middle mb-0">
    <thead><tr><th>Tên loại phòng</th><th class="text-center">Số người tối đa</th><th class="text-end">Đơn giá/tháng</th><th class="text-center">Số phòng</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
    @foreach (var x in Model)
    {
        <tr>
            <td>@x.Loai.TenLoaiPhong</td>
            <td class="text-center">@x.Loai.SoNguoiToiDa</td>
            <td class="text-end">@x.Loai.DonGiaThang.ToString("N0") đ</td>
            <td class="text-center">@x.SoPhong</td>
            <td><span class="badge @HienThiHelper.LopBadge(x.Loai.TrangThai)">@x.Loai.TrangThai</span></td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@x.Loai.MaLoaiPhong">Chi tiết</a>
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.Loai.MaLoaiPhong">Sửa</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@x.Loai.MaLoaiPhong">Xóa</a>
            </td>
        </tr>
    }
    </tbody>
</table></div></div>
