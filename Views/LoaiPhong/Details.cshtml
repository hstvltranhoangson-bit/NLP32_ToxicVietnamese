@* Họ và tên: [Họ tên Sinh viên 1]
   Mã sinh viên: [MSSV 1]
   Nội dung thực hiện: Module 1 - Tài khoản, đăng nhập, phân quyền, quản lý loại phòng *@
@model LoaiPhong
@{ ViewData["Title"] = "Chi tiết loại phòng"; }
<h3 class="mb-3">Chi tiết loại phòng</h3>
<div class="card mb-3"><div class="card-body">
    <dl class="row mb-0">
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.TenLoaiPhong)</dt><dd class="col-sm-9">@Model.TenLoaiPhong</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.SoNguoiToiDa)</dt><dd class="col-sm-9">@Model.SoNguoiToiDa</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.DonGiaThang)</dt><dd class="col-sm-9">@Model.DonGiaThang.ToString("N0") đ</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.MoTa)</dt><dd class="col-sm-9">@Model.MoTa</dd>
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.TrangThai)</dt><dd class="col-sm-9"><span class="badge @HienThiHelper.LopBadge(Model.TrangThai)">@Model.TrangThai</span></dd>
        <dt class="col-sm-3">Số phòng thuộc loại</dt><dd class="col-sm-9">@Model.PhongKTXs.Count</dd>
    </dl>
</div></div>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.MaLoaiPhong">Sửa</a>
<a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a>
