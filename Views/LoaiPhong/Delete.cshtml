@* Họ và tên: [Họ tên Sinh viên 1]
   Mã sinh viên: [MSSV 1]
   Nội dung thực hiện: Module 1 - Tài khoản, đăng nhập, phân quyền, quản lý loại phòng *@
@model LoaiPhong
@{ ViewData["Title"] = "Xóa loại phòng"; }
<h3 class="mb-3 text-danger">Xóa loại phòng</h3>
<div class="alert alert-warning">Bạn có chắc muốn xóa loại phòng <strong>@Model.TenLoaiPhong</strong>?
    @if (Model.PhongKTXs.Count > 0) { <div class="mt-2 fw-bold">Loại phòng đang có @Model.PhongKTXs.Count phòng sử dụng nên hệ thống sẽ từ chối xóa.</div> }
</div>
<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.MaLoaiPhong" />
    <button class="btn btn-danger" type="submit">Xác nhận xóa</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
</form>
