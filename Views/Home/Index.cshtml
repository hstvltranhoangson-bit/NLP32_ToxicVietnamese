@* Họ và tên: [Họ tên Sinh viên 1]
   Mã sinh viên: [MSSV 1]
   Nội dung thực hiện: Module 1 - Tài khoản, đăng nhập, phân quyền, quản lý loại phòng *@
@{ ViewData["Title"] = "Trang chủ"; var vaiTro = Context.Session.LayVaiTro(); }
<div class="p-5 mb-4 bg-white rounded-3 shadow-sm">
    <h1 class="display-6 fw-bold text-primary">Hệ thống quản lý ký túc xá và phân phòng sinh viên</h1>
    <p class="lead mb-4">Đăng ký chỗ ở, theo dõi phòng đang ở và lịch sử ở ký túc xá nhanh chóng, minh bạch.</p>
    @if (vaiTro == null)
    {
        <a class="btn btn-primary btn-lg" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập để bắt đầu</a>
    }
    else if (vaiTro == VaiTro.Admin)
    {
        <a class="btn btn-primary me-2" asp-controller="ThongKe" asp-action="Dashboard">Xem Dashboard</a>
        <a class="btn btn-outline-primary me-2" asp-controller="PhanPhong" asp-action="ChoDuyet">Duyệt đăng ký chờ</a>
        <a class="btn btn-outline-primary" asp-controller="PhongKTX" asp-action="Index">Quản lý phòng</a>
    }
    else
    {
        <a class="btn btn-primary me-2" asp-controller="PhongKTX" asp-action="Index">Xem phòng còn chỗ</a>
        <a class="btn btn-outline-primary me-2" asp-controller="DangKyKTX" asp-action="Create">Đăng ký ở KTX</a>
        <a class="btn btn-outline-primary" asp-controller="SinhVien" asp-action="CaNhan">Thông tin cá nhân</a>
    }
</div>
<div class="row g-3">
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><h5>📋 Đăng ký</h5><p class="mb-0 text-muted">Gửi yêu cầu ở KTX, theo dõi trạng thái Chờ duyệt → Đã phân phòng.</p></div></div></div>
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><h5>🛏️ Phân phòng</h5><p class="mb-0 text-muted">Hệ thống kiểm tra sức chứa, giới tính và trạng thái phòng trước khi xếp chỗ.</p></div></div></div>
    <div class="col-md-4"><div class="card h-100"><div class="card-body"><h5>🕘 Lịch sử</h5><p class="mb-0 text-muted">Mọi lần chuyển phòng, trả phòng đều được lưu lại đầy đủ.</p></div></div></div>
</div>
