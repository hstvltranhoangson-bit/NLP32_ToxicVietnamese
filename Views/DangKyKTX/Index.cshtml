@* Họ và tên: [Họ tên Sinh viên 3]
   Mã sinh viên: [MSSV 3]
   Nội dung thực hiện: Module 3 - Quản lý sinh viên, đăng ký ở KTX, xem thông tin/lịch sử ở *@
@model QuanLyKyTucXa_UNETI_DHTI17A2ND.Helpers.PagedList<DangKyKTX>
@{ ViewData["Title"] = "Quản lý đăng ký"; var loc = (LocDanhSachViewModel)ViewBag.Loc; }
<h3 class="mb-3">Quản lý đăng ký KTX</h3>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="TuKhoa" value="@loc.TuKhoa" class="form-control" placeholder="Mã SV hoặc họ tên..." /></div>
    <div class="col-md-3">
        <select name="TrangThai" class="form-select">
            <option value="">-- Mọi trạng thái --</option>
            @foreach (var t in TrangThaiDangKy.TatCa) { <option value="@t" selected="@(loc.TrangThai == t)">@t</option> }
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-primary">Tìm</button> <a class="btn btn-outline-secondary" asp-action="Index">Xóa lọc</a></div>
</form>
@if (!Model.Items.Any()) { <div class="alert alert-info">Không có đăng ký phù hợp.</div> }
else
{
<div class="card"><div class="table-responsive">
<table class="table table-hover align-middle mb-0">
    <thead><tr><th>Mã</th><th>Sinh viên</th><th>Ngày ĐK</th><th>Bắt đầu</th><th>Kết thúc DK</th><th>Nguyện vọng</th><th>Trạng thái</th><th></th></tr></thead>
    <tbody>
    @foreach (var d in Model.Items)
    {
        <tr>
            <td>#@d.MaDangKy</td><td>@d.SinhVien?.HoTen <small class="text-muted">(@d.MaSinhVien)</small></td>
            <td>@d.NgayDangKy.ToString("dd/MM/yyyy")</td><td>@d.NgayBatDau.ToString("dd/MM/yyyy")</td><td>@d.NgayKetThucDuKien.ToString("dd/MM/yyyy")</td>
            <td>@(d.LoaiPhongNguyenVong?.TenLoaiPhong ?? "-")</td>
            <td><span class="badge @HienThiHelper.LopBadge(d.TrangThai)">@d.TrangThai</span></td>
            <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@d.MaDangKy">Chi tiết</a>
                @if (d.TrangThai == TrangThaiDangKy.ChoDuyet)
                {
                    <a class="btn btn-sm btn-success" asp-controller="PhanPhong" asp-action="Phan" asp-route-id="@d.MaDangKy">Phân phòng</a>
                    <form asp-action="Huy" asp-route-id="@d.MaDangKy" method="post" class="d-inline" onsubmit="return confirm('Hủy đăng ký này?');"><button class="btn btn-sm btn-outline-warning" type="submit">Hủy</button></form>
                }
                @if (d.TrangThai == TrangThaiDangKy.ChoDuyet || d.TrangThai == TrangThaiDangKy.DaHuy)
                {
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@d.MaDangKy">Xóa</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table></div></div>
}
<div class="mt-3"><partial name="_PhanTrang" model="(PhanTrangViewModel)ViewBag.PhanTrang" /></div>
