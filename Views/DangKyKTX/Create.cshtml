@* Họ và tên: [Họ tên Sinh viên 3]
   Mã sinh viên: [MSSV 3]
   Nội dung thực hiện: Module 3 - Quản lý sinh viên, đăng ký ở KTX, xem thông tin/lịch sử ở *@
@model DangKyKtxCreateViewModel
@{ ViewData["Title"] = "Đăng ký ở KTX"; }
<h3 class="mb-3">Đăng ký ở ký túc xá</h3>
<div class="row"><div class="col-lg-8">
<div class="card"><div class="card-body">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="NgayBatDau" class="form-label"></label><input asp-for="NgayBatDau" type="date" class="form-control" /><span asp-validation-for="NgayBatDau" class="text-danger"></span></div>
            <div class="col-md-6"><label asp-for="NgayKetThucDuKien" class="form-label"></label><input asp-for="NgayKetThucDuKien" type="date" class="form-control" /><span asp-validation-for="NgayKetThucDuKien" class="text-danger"></span></div>
            <div class="col-md-12">
                <label asp-for="NguyenVongLoaiPhong" class="form-label"></label>
                <select asp-for="NguyenVongLoaiPhong" asp-items="Model.LoaiPhongs" class="form-select"><option value="">-- Không có nguyện vọng --</option></select>
                <div class="form-text">Nguyện vọng chỉ mang tính tham khảo; Ban quản lý sẽ xếp phòng theo chỗ thực tế còn trống.</div>
            </div>
            <div class="col-md-12"><label asp-for="GhiChu" class="form-label"></label><textarea asp-for="GhiChu" rows="3" class="form-control"></textarea><span asp-validation-for="GhiChu" class="text-danger"></span></div>
        </div>
        <div class="mt-3"><button class="btn btn-primary" type="submit">Gửi đăng ký</button> <a class="btn btn-outline-secondary" asp-controller="PhongKTX" asp-action="Index">Xem phòng còn chỗ</a></div>
    </form>
</div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
