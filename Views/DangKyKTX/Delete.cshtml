@* Họ và tên: [Họ tên Sinh viên 3]
   Mã sinh viên: [MSSV 3]
   Nội dung thực hiện: Module 3 - Quản lý sinh viên, đăng ký ở KTX, xem thông tin/lịch sử ở *@
@model DangKyKTX
@{ ViewData["Title"] = "Xóa đăng ký"; }
<h3 class="mb-3 text-danger">Xóa đăng ký</h3>
<div class="alert alert-warning">Xóa đăng ký #@Model.MaDangKy của <strong>@Model.SinhVien?.HoTen</strong> (@Model.TrangThai)? Đăng ký đã phân phòng không thể xóa.</div>
<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.MaDangKy" />
    <button class="btn btn-danger" type="submit">Xác nhận xóa</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Hủy</a>
</form>
