@* Họ và tên: [Họ tên Sinh viên 4]
   Mã sinh viên: [MSSV 4]
   Nội dung thực hiện: Module 4 - Phân phòng, chuyển phòng, trả phòng, Dashboard, thống kê *@
@model QuanLyKyTucXa_UNETI_DHTI17A2ND.Helpers.PagedList<PhanPhong>
@{ ViewData["Title"] = "Lịch sử phân phòng"; var loc = (LocDanhSachViewModel)ViewBag.Loc; }
<h3 class="mb-3">Lịch sử phân phòng</h3>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-4"><input name="TuKhoa" value="@loc.TuKhoa" class="form-control" placeholder="Mã SV, họ tên hoặc tên phòng..." /></div>
    <div class="col-md-3">
        <select name="TrangThai" class="form-select">
            <option value="">-- Mọi trạng thái --</option>
            @foreach (var t in TrangThaiPhanPhong.TatCa) { <option value="@t" selected="@(loc.TrangThai == t)">@t</option> }
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-primary">Lọc</button> <a class="btn btn-outline-secondary" asp-action="LichSu">Xóa lọc</a></div>
</form>
@if (!Model.Items.Any()) { <div class="alert alert-info">Không có bản ghi phù hợp.</div> }
else
{
<div class="card"><div class="table-responsive">
<table class="table table-hover align-middle mb-0">
    <thead><tr><th>Sinh viên</th><th>Phòng</th><th>Tòa/Tầng</th><th>Ngày vào</th><th>Ngày ra</th><th>Trạng thái</th></tr></thead>
    <tbody>
    @foreach (var p in Model.Items)
    {
        <tr>
            <td>@p.DangKy?.SinhVien?.HoTen <small class="text-muted">(@p.DangKy?.MaSinhVien)</small></td>
            <td class="fw-semibold">@p.Phong?.TenPhong</td><td>@p.Phong?.ToaNha - T@(p.Phong?.Tang)</td>
            <td>@p.NgayVao.ToString("dd/MM/yyyy")</td><td>@(p.NgayRa?.ToString("dd/MM/yyyy") ?? "-")</td>
            <td><span class="badge @HienThiHelper.LopBadge(p.TrangThai)">@p.TrangThai</span></td>
        </tr>
    }
    </tbody>
</table></div></div>
}
<div class="mt-3"><partial name="_PhanTrang" model="(PhanTrangViewModel)ViewBag.PhanTrang" /></div>
