@* Họ và tên: [Họ tên Sinh viên 4]
   Mã sinh viên: [MSSV 4]
   Nội dung thực hiện: Module 4 - Phân phòng, chuyển phòng, trả phòng, Dashboard, thống kê *@
@model List<DangKyKTX>
@{ ViewData["Title"] = "Duyệt đăng ký"; }
<h3 class="mb-3">Đăng ký chờ duyệt (@Model.Count)</h3>
@if (Model.Count == 0) { <div class="alert alert-info">Không có đăng ký nào đang chờ duyệt.</div> }
else
{
<div class="card"><div class="table-responsive">
<table class="table table-hover align-middle mb-0">
    <thead><tr><th>Mã</th><th>Sinh viên</th><th>Giới tính</th><th>Ngày ĐK</th><th>Bắt đầu</th><th>Nguyện vọng</th><th>Ghi chú</th><th></th></tr></thead>
    <tbody>
    @foreach (var d in Model)
    {
        <tr>
            <td>#@d.MaDangKy</td><td>@d.SinhVien?.HoTen <small class="text-muted">(@d.MaSinhVien)</small></td><td>@d.SinhVien?.GioiTinh</td>
            <td>@d.NgayDangKy.ToString("dd/MM/yyyy")</td><td>@d.NgayBatDau.ToString("dd/MM/yyyy")</td>
            <td>@(d.LoaiPhongNguyenVong?.TenLoaiPhong ?? "-")</td><td>@d.GhiChu</td>
            <td class="text-end text-nowrap">
                <a class="btn btn-sm btn-success" asp-action="Phan" asp-route-id="@d.MaDangKy">Chọn phòng &amp; phân phòng</a>
            </td>
        </tr>
    }
    </tbody>
</table></div></div>
}
