@* Họ và tên: [Họ tên Sinh viên 4]
   Mã sinh viên: [MSSV 4]
   Nội dung thực hiện: Module 4 - Phân phòng, chuyển phòng, trả phòng, Dashboard, thống kê *@
@model ChuyenPhongViewModel
@{ ViewData["Title"] = "Chuyển phòng"; }
<h3 class="mb-3">Chuyển phòng - @Model.HoTen</h3>
<div class="card"><div class="card-body">
    <dl class="row">
        <dt class="col-sm-3">Sinh viên</dt><dd class="col-sm-9">@Model.HoTen (@Model.MaSinhVien) - @Model.GioiTinh</dd>
        <dt class="col-sm-3">Phòng hiện tại</dt><dd class="col-sm-9">@Model.TenPhongHienTai (từ @Model.NgayVaoHienTai.ToString("dd/MM/yyyy"))</dd>
    </dl>
    @if (Model.TrangThaiHienTai != TrangThaiPhanPhong.DangO)
    {
        <div class="alert alert-warning">Sinh viên không còn ở phòng này (trạng thái: @Model.TrangThaiHienTai) nên không thể chuyển phòng.</div>
    }
    else
    {
    <form asp-action="Chuyen" asp-route-id="@Model.MaPhanPhong" method="post">
        <input type="hidden" asp-for="MaPhanPhong" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="MaPhongMoi" class="form-label"></label>
                <select asp-for="MaPhongMoi" class="form-select">
                    <option value="0">-- Chọn phòng mới --</option>
                    @foreach (var p in Model.PhongCoTheChon) { <option value="@p.MaPhong" selected="@(p.MaPhong == Model.MaPhongMoi)">@p.NhanChon</option> }
                </select>
                <span asp-validation-for="MaPhongMoi" class="text-danger"></span>
            </div>
            <div class="col-md-4"><label asp-for="NgayChuyen" class="form-label"></label><input asp-for="NgayChuyen" type="date" class="form-control" /><span asp-validation-for="NgayChuyen" class="text-danger"></span></div>
        </div>
        <div class="form-text mt-2">Bản ghi phòng cũ chuyển sang "Đã chuyển" và ghi ngày ra; hệ thống tạo bản ghi mới "Đang ở" để giữ lịch sử.</div>
        <div class="mt-3"><button class="btn btn-primary" type="submit">Xác nhận chuyển phòng</button> <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a></div>
    </form>
    }
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
