@* Họ và tên: [Họ tên Sinh viên 2]
   Mã sinh viên: [MSSV 2]
   Nội dung thực hiện: Module 2 - Quản lý phòng KTX, tìm kiếm, lọc, sắp xếp, phân trang *@
@model PhongListViewModel
@{
    ViewData["Title"] = "Danh sách phòng";
    var f = Model.Filter;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">@(Model.LaAdmin ? "Quản lý phòng ký túc xá" : "Phòng còn chỗ")</h3>
    @if (Model.LaAdmin) { <a class="btn btn-primary" asp-action="Create">+ Thêm phòng</a> }
    else { <a class="btn btn-success" asp-controller="DangKyKTX" asp-action="Create">Đăng ký ở KTX</a> }
</div>

@* Một form GET duy nhất: tìm kiếm + lọc + sắp xếp được gửi cùng nhau, Trang luôn về 1 khi lọc lại *@
<form method="get" asp-action="Index" class="card card-body mb-3">
    <div class="row g-2">
        <div class="col-md-3"><input name="TuKhoa" value="@f.TuKhoa" class="form-control" placeholder="Tìm tên phòng / tòa nhà..." /></div>
        <div class="col-md-2">
            <select name="MaLoaiPhong" class="form-select">
                <option value="">-- Loại phòng --</option>
                @foreach (var o in Model.LoaiPhongs) { <option value="@o.Value" selected="@o.Selected">@o.Text</option> }
            </select>
        </div>
        <div class="col-md-2">
            <select name="ToaNha" class="form-select">
                <option value="">-- Tòa nhà --</option>
                @foreach (var o in Model.ToaNhas) { <option value="@o.Value" selected="@o.Selected">@o.Text</option> }
            </select>
        </div>
        <div class="col-md-2">
            <select name="Tang" class="form-select">
                <option value="">-- Tầng --</option>
                @foreach (var o in Model.Tangs) { <option value="@o.Value" selected="@o.Selected">@o.Text</option> }
            </select>
        </div>
        <div class="col-md-2">
            <select name="GioiTinhPhong" class="form-select">
                <option value="">-- Giới tính phòng --</option>
                @foreach (var g in GioiTinh.TatCa) { <option value="@g" selected="@(f.GioiTinhPhong == g)">Phòng @g</option> }
            </select>
        </div>
        @if (Model.LaAdmin)
        {
            <div class="col-md-2">
                <select name="TrangThai" class="form-select">
                    <option value="">-- Trạng thái --</option>
                    @foreach (var t in TrangThaiPhong.TatCa) { <option value="@t" selected="@(f.TrangThai == t)">@t</option> }
                </select>
            </div>
            <div class="col-md-2">
                <select name="ConCho" class="form-select">
                    <option value="">-- Còn chỗ/Hết chỗ --</option>
                    <option value="con" selected="@(f.ConCho == "con")">Còn chỗ</option>
                    <option value="het" selected="@(f.ConCho == "het")">Hết chỗ</option>
                </select>
            </div>
        }
        <div class="col-md-3">
            <select name="SapXep" class="form-select">
                <option value="ten_asc" selected="@(f.SapXep == "ten_asc")">Tên phòng A → Z</option>
                <option value="ten_desc" selected="@(f.SapXep == "ten_desc")">Tên phòng Z → A</option>
                <option value="tang_asc" selected="@(f.SapXep == "tang_asc")">Tầng tăng dần</option>
                <option value="tang_desc" selected="@(f.SapXep == "tang_desc")">Tầng giảm dần</option>
                <option value="cho_asc" selected="@(f.SapXep == "cho_asc")">Số chỗ còn tăng dần</option>
                <option value="cho_desc" selected="@(f.SapXep == "cho_desc")">Số chỗ còn giảm dần</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Áp dụng</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Xóa lọc</a>
        </div>
    </div>
</form>

@if (!Model.KetQua.Items.Any())
{
    <div class="alert alert-info">Không tìm thấy phòng nào phù hợp với điều kiện đã chọn.</div>
}
else
{
    <div class="card"><div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Tên phòng</th><th>Loại phòng</th><th>Tòa nhà</th><th class="text-center">Tầng</th><th>Giới tính</th>
                <th class="text-center">Đang ở / Sức chứa</th><th class="text-center">Còn</th><th>Trạng thái</th><th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var p in Model.KetQua.Items)
        {
            <tr>
                <td class="fw-semibold">@p.TenPhong</td>
                <td>@p.TenLoaiPhong</td>
                <td>@p.ToaNha</td>
                <td class="text-center">@p.Tang</td>
                <td>@p.GioiTinhPhong</td>
                <td class="text-center">
                    @p.SoDangO / @p.SucChua
                    <div class="progress progress-sm"><div class="progress-bar @(p.ConCho ? "bg-success" : "bg-danger")" style="width:@p.TyLeSuDung.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></div></div>
                </td>
                <td class="text-center">
                    @if (p.ConCho) { <span class="badge bg-success">Còn @p.SoChoCon chỗ</span> }
                    else { <span class="badge bg-danger">Hết chỗ</span> }
                </td>
                <td><span class="badge @HienThiHelper.LopBadge(p.TrangThai)">@p.TrangThai</span></td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@p.MaPhong">Chi tiết</a>
                    @if (Model.LaAdmin)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.MaPhong">Sửa</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@p.MaPhong">Xóa</a>
                        <form asp-action="DoiTrangThai" asp-route-id="@p.MaPhong" asp-route-quayLai="@(Context.Request.Path + Context.Request.QueryString)" method="post" class="d-inline">
                            <button class="btn btn-sm btn-outline-warning" type="submit">@(p.TrangThai == TrangThaiPhong.DangSuDung ? "Tạm ngừng" : "Kích hoạt")</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table></div></div>
}
<div class="mt-3"><partial name="_PhanTrang" model="PhanTrangViewModel.Tao(Model.KetQua, Model.Filter.ToRouteValues())" /></div>
