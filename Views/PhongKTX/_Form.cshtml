@* Họ và tên: [Họ tên Sinh viên 2]
   Mã sinh viên: [MSSV 2]
   Nội dung thực hiện: Module 2 - Quản lý phòng KTX, tìm kiếm, lọc, sắp xếp, phân trang *@
@model PhongKTX
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="row g-3">
    <div class="col-md-4"><label asp-for="TenPhong" class="form-label"></label><input asp-for="TenPhong" class="form-control" /><span asp-validation-for="TenPhong" class="text-danger"></span></div>
    <div class="col-md-4">
        <label asp-for="MaLoaiPhong" class="form-label"></label>
        <select asp-for="MaLoaiPhong" asp-items="(List<SelectListItem>)ViewBag.LoaiPhongs" class="form-select"><option value="0">-- Chọn loại phòng --</option></select>
        <span asp-validation-for="MaLoaiPhong" class="text-danger"></span>
    </div>
    <div class="col-md-2"><label asp-for="ToaNha" class="form-label"></label><input asp-for="ToaNha" class="form-control" /><span asp-validation-for="ToaNha" class="text-danger"></span></div>
    <div class="col-md-2"><label asp-for="Tang" class="form-label"></label><input asp-for="Tang" type="number" min="1" max="20" class="form-control" /><span asp-validation-for="Tang" class="text-danger"></span></div>
    <div class="col-md-4">
        <label class="form-label d-block">@Html.DisplayNameFor(m => m.GioiTinhPhong)</label>
        @foreach (var g in GioiTinh.TatCa)
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="GioiTinhPhong" value="@g" id="gt_@g" />
                <label class="form-check-label" for="gt_@g">@g</label>
            </div>
        }
        <span asp-validation-for="GioiTinhPhong" class="text-danger d-block"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="TrangThai" class="form-label"></label>
        <select asp-for="TrangThai" class="form-select">
            @foreach (var t in TrangThaiPhong.TatCa) { <option value="@t">@t</option> }
        </select>
        <span asp-validation-for="TrangThai" class="text-danger"></span>
    </div>
    <div class="col-12"><label asp-for="MoTa" class="form-label"></label><textarea asp-for="MoTa" rows="3" class="form-control"></textarea><span asp-validation-for="MoTa" class="text-danger"></span></div>
</div>
<div class="form-text mt-2">Số chỗ còn không nhập tay: hệ thống tự tính = sức chứa loại phòng − số sinh viên đang ở.</div>
