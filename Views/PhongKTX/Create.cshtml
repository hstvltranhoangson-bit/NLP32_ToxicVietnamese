@* Họ và tên: [Họ tên Sinh viên 2]
   Mã sinh viên: [MSSV 2]
   Nội dung thực hiện: Module 2 - Quản lý phòng KTX, tìm kiếm, lọc, sắp xếp, phân trang *@
@model PhongKTX
@{ ViewData["Title"] = "Thêm phòng"; }
<h3 class="mb-3">Thêm phòng ký túc xá</h3>
<div class="card"><div class="card-body">
    <form asp-action="Create" method="post">
        <partial name="_Form" model="Model" />
        <div class="mt-3"><button class="btn btn-primary" type="submit">Lưu</button> <a class="btn btn-outline-secondary" asp-action="Index">Quay lại</a></div>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
