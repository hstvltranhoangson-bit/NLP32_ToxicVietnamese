@* Họ và tên: [Họ tên Sinh viên 2]
   Mã sinh viên: [MSSV 2]
   Nội dung thực hiện: Module 2 - Quản lý phòng KTX, tìm kiếm, lọc, sắp xếp, phân trang *@
@model PhongDetailsViewModel
@{ ViewData["Title"] = "Chi tiết phòng"; var p = Model.Phong; }
<h3 class="mb-3">Phòng @p.TenPhong</h3>
<div class="row g-3">
    <div class="col-lg-6"><div class="card h-100"><div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Loại phòng</dt><dd class="col-sm-8">@p.TenLoaiPhong (@p.DonGiaThang.ToString("N0") đ/tháng)</dd>
            <dt class="col-sm-4">Vị trí</dt><dd class="col-sm-8">@p.ToaNha - Tầng @p.Tang</dd>
            <dt class="col-sm-4">Giới tính phòng</dt><dd class="col-sm-8">@p.GioiTinhPhong</dd>
            <dt class="col-sm-4">Trạng thái</dt><dd class="col-sm-8"><span class="badge @HienThiHelper.LopBadge(p.TrangThai)">@p.TrangThai</span></dd>
            <dt class="col-sm-4">Sức chứa</dt><dd class="col-sm-8">@p.SucChua người</dd>
            <dt class="col-sm-4">Đang ở</dt><dd class="col-sm-8">@p.SoDangO người</dd>
            <dt class="col-sm-4">Số chỗ còn</dt><dd class="col-sm-8"><strong class="@(p.ConCho ? "text-success" : "text-danger")">@p.SoChoCon</strong> (tính từ dữ liệu thực tế)</dd>
            <dt class="col-sm-4">Mô tả</dt><dd class="col-sm-8">@p.MoTa</dd>
        </dl>
    </div></div></div>
    @if (Model.LaAdmin)
    {
        <div class="col-lg-6"><div class="card h-100"><div class="card-body">
            <h5>Sinh viên đang ở</h5>
            @if (Model.NguoiDangO.Count == 0) { <p class="text-muted">Phòng hiện chưa có sinh viên.</p> }
            else
            {
                <table class="table table-sm">
                    <thead><tr><th>Mã SV</th><th>Họ tên</th><th>Ngày vào</th><th>Dự kiến ra</th></tr></thead>
                    <tbody>
                    @foreach (var n in Model.NguoiDangO)
                    {
                        <tr><td>@n.MaSinhVien</td><td>@n.HoTen</td><td>@n.NgayVao.ToString("dd/MM/yyyy")</td><td>@n.NgayKetThucDuKien.ToString("dd/MM/yyyy")</td></tr>
                    }
                    </tbody>
                </table>
            }
        </div></div></div>
    }
</div>
<div class="mt-3">
    @if (Model.LaAdmin) { <a class="btn btn-primary" asp-action="Edit" asp-route-id="@p.MaPhong">Sửa</a> }
    <a class="btn btn-outline-secondary" asp-action="Index">Quay lại danh sách</a>
</div>
